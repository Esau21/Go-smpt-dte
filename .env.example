TRACE_TYPE="STDOUT"
SERVICE_NAME="smtp-dte"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
PUBLIC_ORIGIN=""
AFTER_LOGIN_PATH=""
MAIL_PROVIDER=""
# Bucket de Google Cloud Storage donde la app guarda todo:
# las facturas, las notas y los archivos. No se usa base de datos.
# En local se usa el emulador del compose. En produccion deja
# STORAGE_EMULATOR_HOST vacio y configura credenciales de Google
# (GOOGLE_APPLICATION_CREDENTIALS o la cuenta de servicio de la maquina).
FILES_BUCKET="bookeep-archivos"
STORAGE_EMULATOR_HOST="gcs:4443"

# Proveedores de correo: uno o varios separados por coma. Ejemplo: GMAIL,OUTLOOK
# MAIL_PROVIDER="GMAIL,OUTLOOK"

# Outlook / Microsoft 365. Requiere registrar una aplicacion en Azure
# (portal.azure.com > Microsoft Entra ID > Registros de aplicaciones):
#   - URI de redireccion (Web): <PUBLIC_ORIGIN>/api/auth/microsoft/callback
#   - Permisos delegados de Microsoft Graph: User.Read, Mail.Read, offline_access
# OUTLOOK_TENANT es opcional; "common" acepta cuentas personales y de empresa.
OUTLOOK_CLIENT_ID=""
OUTLOOK_CLIENT_SECRET=""
OUTLOOK_TENANT="common"
