DB_USER="mongo"
DB_PASS="1234"
DB_NAME="backend_golang_gin"
DB_STRING="host=postgres user=mongo password=1234 dbname=backend_golang_gin port=5432 sslmode=disable"
DB_CONTEXT="postgresql"
TRACE_TYPE="STDOUT"
SERVICE_NAME="smtp-dte"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
PUBLIC_ORIGIN=""
AFTER_LOGIN_PATH=""
MAIL_PROVIDER=""
# Bucket de Google Cloud Storage para los archivos guardados "en la nube".
# En local se usa el emulador del compose. En produccion deja
# STORAGE_EMULATOR_HOST vacio y configura credenciales de Google
# (GOOGLE_APPLICATION_CREDENTIALS o la cuenta de servicio de la maquina).
FILES_BUCKET="bookeep-archivos"
STORAGE_EMULATOR_HOST="gcs:4443"
